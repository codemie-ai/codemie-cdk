{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.prod*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.prod*)",
      "Read(**/backups/**)",
      "Edit(**/backups/**)",
      "Read(**/*.tfvars)",
      "Edit(**/*.tfvars)",
      "Read(**/*.tfstate*)",
      "Edit(**/*.tfstate*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Edit(**/.codemie/state.json)",
      "Edit(**/poetry.lock)",
      "Edit(**/package-lock.json)",
      "Edit(./.claude/settings.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git commit*--no-verify*)",
      "Bash(* --no-verify*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(codemie deploy*)",
      "Bash(codemie destroy*)",
      "Bash(npx codemie deploy*)",
      "Bash(npx codemie destroy*)",
      "Bash(npx @codemieai/cdk deploy*)",
      "Bash(npx @codemieai/cdk destroy*)",
      "Bash(node *cli/index.js deploy*)",
      "Bash(node *cli/index.js destroy*)",
      "Bash(codemie-iac *apply*)",
      "Bash(poetry run codemie-iac *apply*)",
      "Bash(python* -m codemie_iac.cli *apply*)",
      "Bash(npm publish*)",
      "Bash(poetry publish*)",
      "Bash(twine upload*)",
      "Bash(gh release create*)",
      "Bash(gh workflow run*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform state rm*)",
      "Bash(terraform state push*)",
      "Bash(terraform import*)",
      "Bash(terraform force-unlock*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl apply*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(aws * delete*)",
      "Bash(az * delete*)"
    ]
  }
}
