      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.prod*)",
      "Read(/**/.env.dev*)",
      "Read(/**/.env.stag*)",
      "Read(/**/.env.uat*)",
      "Read(/**/.env.qa*)",
      "Read(/**/.env.test*)",
      "Read(/**/*.env)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/.env.prod*)",
      "Edit(/**/.env.dev*)",
      "Edit(/**/.env.stag*)",
      "Edit(/**/.env.uat*)",
      "Edit(/**/.env.qa*)",
      "Edit(/**/.env.test*)",
      "Edit(/**/*.env)",
      "Read(/**/backups/**)",
      "Edit(/**/backups/**)",
      "Read(/**/*.tfvars)",
      "Edit(/**/*.tfvars)",
      "Read(/**/*.tfstate*)",
      "Edit(/**/*.tfstate*)",
      "Read(/**/*.pem)",
      "Edit(/**/*.pem)",
      "Read(/**/*.key)",
      "Edit(/**/*.key)",
      "Read(/**/*.p12)",
      "Edit(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Edit(/**/*.pfx)",
      "Read(/**/.npmrc)",
      "Edit(/**/.npmrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Edit(/**/.codemie/state.json)",
      "Edit(/**/poetry.lock)",
      "Edit(/**/package-lock.json)",
      "Edit(/.claude/settings.json)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push --force)",
