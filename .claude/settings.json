      "Bash(git -C * push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * reset * --hard*)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git commit*--no-verify*)",
      "Bash(* --no-verify*)"
