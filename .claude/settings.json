    "ask": [
      "Bash(git push *--force-with-lease*)",
      "Bash(git -C * push *--force-with-lease*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm * --recursive*)",
