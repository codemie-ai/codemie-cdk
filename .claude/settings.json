      "Bash(npx * @codemieai/cdk* deploy*)",
      "Bash(npm exec *codemie-cdk* deploy*)",
      "Bash(*cli/index.js deploy*)",
      "Bash(*cli/index.ts deploy*)",
      "Bash(codemie-cdk destroy*)",
      "Bash(*/codemie-cdk destroy*)",
      "Bash(npx codemie-cdk destroy*)",
      "Bash(npx * codemie-cdk destroy*)",
      "Bash(npx @codemieai/cdk* destroy*)",
      "Bash(npx * @codemieai/cdk* destroy*)",
      "Bash(npm exec *codemie-cdk* destroy*)",
      "Bash(*cli/index.js destroy*)",
