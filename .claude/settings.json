      "Bash(*/codemie-iac * apply)",
      "Bash(*/codemie-iac * apply *)",
      "Bash(poetry * codemie-iac apply*)",
      "Bash(poetry * codemie-iac * apply)",
      "Bash(poetry * codemie-iac * apply *)",
      "Bash(*codemie_iac.cli apply*)",
      "Bash(*codemie_iac.cli * apply)",
      "Bash(*codemie_iac.cli * apply *)",
      "Bash(npm publish*)",
      "Bash(poetry publish*)",
      "Bash(twine upload*)",
      "Bash(gh release create*)",
      "Bash(gh workflow run*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform state rm*)",
      "Bash(terraform state push*)",
      "Bash(terraform import*)",
      "Bash(terraform force-unlock*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl apply*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(aws * delete*)",
      "Bash(az * delete*)",
      "Edit(/.github/workflows/**)",
      "Edit(/.gitleaks.toml)"
    ]
  }
}
